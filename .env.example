# KrishiSahayak AI - environment template
# Copy this file to .env and fill in real values. NEVER commit the real .env.

# Secret used to sign JWT access tokens (required in production)
JWT_SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file location (leave empty to use backend/krishi_sahayak.db)
KRISHI_DB_PATH=

# Optional external vision provider key for CropDoctor AI (demo works without it)
CROP_DOCTOR_API_KEY=

# Comma-separated allowed CORS origins ('*' for local development only)
CORS_ORIGINS=*
