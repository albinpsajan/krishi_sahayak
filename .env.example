# KrishiSahayak AI - environment template
#
# Copy this file to .env and fill in real values. NEVER commit the real .env.
#
# NOTE: backend/config/settings.py reads these values from the process
# environment via os.environ. The application does not parse a .env file on its
# own, so export the values before starting the app, for example:
#
#   PowerShell :  $env:JWT_SECRET_KEY = "a-long-random-string"
#   bash/zsh   :  export JWT_SECRET_KEY="a-long-random-string"
#
# The app runs with none of these set for local development (dev fallbacks).

# --- Security -------------------------------------------------------------
# Secret used to sign JWT access tokens (HS256, 24h expiry).
# REQUIRED in production - the built-in fallback is a public demo value.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Database -------------------------------------------------------------
# SQLite database file location.
# Leave empty to use backend/krishi_sahayak.db
KRISHI_DB_PATH=

# Full SQLAlchemy connection URL. Takes precedence over KRISHI_DB_PATH when set.
# Examples: postgresql+psycopg://user:pass@localhost:5432/krishi
DATABASE_URL=

# --- AI provider (optional) ----------------------------------------------
# Optional external vision provider key for CropDoctor AI.
# The demo runs entirely on the local knowledge base when this is empty.
CROP_DOCTOR_API_KEY=

# --- Verified market prices ----------------------------------------------
# Optional data.gov.in API key. The primary provider is the public AGMARKNET
# portal API; this key is used only as a secondary official feed.
# No matching official record means unavailable; never synthetic prices.
DATA_GOV_API_KEY=

# --- HTTP -----------------------------------------------------------------
# Comma-separated allowed CORS origins ('*' for local development only).
CORS_ORIGINS=*

# --- Local runner (run_app.py) -------------------------------------------
# Port for the local pilot server.
PORT=8000

# Set to 1 to enable Uvicorn auto-reload during development.
KRISHI_RELOAD=

# --- Tests ----------------------------------------------------------------
# tests/test_environment.py overrides this with an isolated temporary file.
# Set it manually only when you want the suite to use a specific database.
# KRISHI_DB_PATH=
